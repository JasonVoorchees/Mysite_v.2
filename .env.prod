# Production environment variables for Trezo
# Replace placeholder values with deployment secrets before running in production.
DEBUG=0
SECRET_KEY=TODO_REPLACE_WITH_STRONG_SECRET_KEY
ALLOWED_HOSTS=trezo.ru,www.trezo.ru

# Database configuration
DB_NAME=trezo_prod
DB_USER=trezo_user
DB_PASSWORD=change_me
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}

